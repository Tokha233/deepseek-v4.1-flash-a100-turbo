[
  "vllm",
  "serve",
  "/models/DeepSeek-V4.1-Flash",
  "--served-model-name",
  "deepseek-ai/DeepSeek-V4.1-Flash",
  "--host",
  "0.0.0.0",
  "--port",
  "8083",
  "--tensor-parallel-size",
  "4",
  "--enable-expert-parallel",
  "--language-model-only",
  "--max-model-len",
  "524288",
  "--max-num-seqs",
  "64",
  "--max-num-batched-tokens",
  "8192",
  "--gpu-memory-utilization",
  "0.90",
  "--kv-cache-dtype",
  "fp8_ds_mla",
  "--engram-config",
  "{\"cpu_offload\":true}",
  "--tokenizer-mode",
  "deepseek_v41",
  "--enable-auto-tool-choice",
  "--tool-call-parser",
  "deepseek_v41",
  "--reasoning-parser",
  "deepseek_v41",
  "--enable-prompt-tokens-details",
  "--enable-prefix-caching",
  "--compilation-config",
  "{\"mode\": 0, \"cudagraph_mode\": \"FULL_DECODE_ONLY\", \"cudagraph_capture_sizes\": [5, 6, 10, 12, 20, 24, 40, 48, 80, 96, 160, 192, 320, 384], \"max_cudagraph_capture_size\": 384}",
  "--speculative-config",
  "{\"method\": \"dspark\", \"num_speculative_tokens\": 5, \"use_local_argmax_reduction\": true}",
  "--profiler-config",
  "{\"profiler\": \"torch\", \"torch_profiler_dir\": \"/workspace/profiles\", \"torch_profiler_with_stack\": false, \"ignore_frontend\": true, \"delay_iterations\": 3, \"max_iterations\": 12}",
  "--data-parallel-size",
  "2",
  "--data-parallel-size-local",
  "2",
  "--all2all-backend",
  "allgather_reducescatter",
  "--hf-overrides",
  "{\"head_dtype\":\"float32\"}",
  "--enable-eplb",
  "--eplb-config",
  "{\"window_size\": 1000, \"step_interval\": 3000, \"num_redundant_experts\": 0, \"use_async\": true, \"log_balancedness\": true, \"log_balancedness_interval\": 500}",
  "--shutdown-timeout",
  "600"
]
